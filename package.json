{
  "name": "kiosque",
  "version": "1.0.0",
  "private": true,
  "description": "Le Kiosque — plateforme libre pour les journaux étudiants",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "kiosque": "packages/pipeline/src/cli.ts"
  },
  "scripts": {
    "kiosque": "node packages/pipeline/src/cli.ts",
    "demo:sync": "node packages/pipeline/src/cli.ts sync --root examples/demo-journal",
    "demo:build": "node packages/pipeline/src/cli.ts build --root examples/demo-journal",
    "demo:serve": "python3 -m http.server 8080 --directory examples/demo-journal/dist",
    "site": "node tools/build-site.mjs",
    "kit": "node tools/kit/build-kit.mjs",
    "build": "npm run site",
    "test": "node --test 'tests/**/*.test.ts'",
    "test:continuity": "node --test tests/continuity.test.ts",
    "test:navigateur": "BASE=/autre-nom npm run site && playwright test",
    "typecheck": "tsc --noEmit",
    "radar:reference:check": "node tools/check-radar-source-view.mjs",
    "demo:photos": "node tools/seed-demo-photos.mjs",
    "demo:portraits": "node tools/seed-author-portraits.mjs",
    "ui": "node tools/build-ui.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "le-socle": "github:azdak919/le-socle#69f22348466b2ca6452d4b8a5d2741c142eb94cc",
    "marked": "^18.2.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/cli": "4.3.5",
    "basecoat-css": "1.2.1",
    "tailwindcss": "4.3.5"
  }
}
