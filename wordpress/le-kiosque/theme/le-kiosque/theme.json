{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1180px" },
    "color": {
      "palette": [
        { "slug": "accent", "name": "Couleur du journal", "color": "#6c2163" },
        { "slug": "accent-dark", "name": "Couleur du journal (sombre)", "color": "#cf7ec1" },
        { "slug": "base", "name": "Fond", "color": "#ffffff" },
        { "slug": "contrast", "name": "Texte", "color": "#16181d" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "serif", "name": "Titres", "fontFamily": "Georgia, 'Times New Roman', serif" },
        { "slug": "sans", "name": "Texte", "fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "lineHeight": "1.6" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } },
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "700", "lineHeight": "1.15" } },
      "button": { "color": { "background": "var(--wp--preset--color--accent)", "text": "#ffffff" } }
    },
    "blocks": {
      "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "2.6rem", "fontWeight": "700" }, "elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" } } } },
      "core/navigation": { "typography": { "fontWeight": "700", "fontSize": "0.95rem" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Mât", "area": "header" },
    { "name": "footer", "title": "Pied de page", "area": "footer" }
  ]
}
